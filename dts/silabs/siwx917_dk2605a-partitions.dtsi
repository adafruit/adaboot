/* Partition layout for siwx917_dk2605a: the flash memory map shared by the
 * bootloader and every application image. Generated by
 * tools/partition_layout.py; do not edit by hand -- re-run
 * `python3 tools/partition_layout.py --fix siwx917_dk2605a` after changing
 * the upstream board geometry or tools/boards.toml.
 *
 * Board-specific overlay glue (delete-nodes, device enablement,
 * aliases/chosen) lives in dts/silabs/siwx917_dk2605a.dtsi, which includes
 * this file.
 */

&flash0 {
	partitions {
		boot_partition: partition@202000 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x202000 DT_SIZE_K(128)>;
		};

		slot0_partition: code_partition: partition@222000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x222000 DT_SIZE_K(1880)>;
		};
	};
};
