/* Partition layout for nucleo_n657x0_q: the flash memory map shared by the
 * bootloader and every application image. Generated by
 * tools/partition_layout.py; do not edit by hand -- re-run
 * `python3 tools/partition_layout.py --fix nucleo_n657x0_q` after changing
 * the upstream board geometry or tools/boards.toml.
 *
 * Board-specific overlay glue (delete-nodes, device enablement,
 * aliases/chosen) lives in dts/st/nucleo_n657x0_q.dtsi, which includes
 * this file.
 */

&mx25um51245g {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(256)>;
		};

		slot0_partition: partition@40000 {
			label = "image-0";
			reg = <0x40000 DT_SIZE_M(8)>;
		};

		slot1_partition: partition@840000 {
			label = "image-1";
			reg = <0x840000 DT_SIZE_M(8)>;
		};

		storage_partition: partition@1040000 {
			label = "storage";
			reg = <0x1040000 DT_SIZE_K(32)>;
		};

		nvm_partition: partition@1048000 {
			label = "nvm";
			reg = <0x1048000 DT_SIZE_K(4)>;
		};

		fatfs_partition: partition@1049000 {
			label = "filesystem";
			reg = <0x1049000 DT_SIZE_K(48860)>;
		};
	};
};
