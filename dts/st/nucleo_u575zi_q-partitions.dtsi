/* Partition layout for nucleo_u575zi_q: the flash memory map shared by the
 * bootloader and every application image. Generated by
 * tools/partition_layout.py; do not edit by hand -- re-run
 * `python3 tools/partition_layout.py --fix nucleo_u575zi_q` after changing
 * the upstream board geometry or tools/boards.toml.
 *
 * Board-specific overlay glue (delete-nodes, device enablement,
 * aliases/chosen) lives in dts/st/nucleo_u575zi_q.dtsi, which includes
 * this file.
 */

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(128)>;
		};

		slot0_partition: partition@20000 {
			label = "image-0";
			reg = <0x20000 DT_SIZE_K(952)>;
		};

		storage_partition: partition@10e000 {
			label = "storage";
			reg = <0x10e000 DT_SIZE_K(8)>;
		};

		nvm_partition: partition@110000 {
			label = "nvm";
			reg = <0x110000 DT_SIZE_K(8)>;
		};

		filesystem_partition: partition@112000 {
			label = "filesystem";
			reg = <0x112000 DT_SIZE_K(952)>;
		};
	};
};
