/* STM32H750B-DK standalone layout (no mcuboot): applied to the application
 * image only.
 *
 * The filesystem and a settings partition live on the external QSPI flash
 * (ext_flash). The upstream board DTS already partitions ext_flash with a
 * partition at 0x7800000, which is deleted here and replaced with storage +
 * filesystem (the remainder of the 8 MB external flash).
 */
&ext_flash {
	partitions {
		/delete-node/ partition@7800000;

		storage_partition: partition@7800000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x7800000 DT_SIZE_K(32)>;
		};

		filesystem_partition: partition@7808000 {
			compatible = "zephyr,mapped-partition";
			label = "filesystem";
			reg = <0x7808000 (DT_SIZE_M(8) - DT_SIZE_K(32))>;
		};
	};
};