/* Partition layout for da14695_dk_usb: the flash memory map shared by the
 * bootloader and every application image. Generated by
 * tools/partition_layout.py; do not edit by hand -- re-run
 * `python3 tools/partition_layout.py --fix da14695_dk_usb` after changing
 * the upstream board geometry or tools/boards.toml.
 *
 * Board-specific overlay glue (delete-nodes, device enablement,
 * aliases/chosen) lives in dts/renesas/da14695_dk_usb.dtsi, which includes
 * this file.
 */

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* 0x0-0x2400 reserved for product header.
		 * MCUboot limited to 64 KB cacheable area. */
		boot_partition: partition@2400 {
			label = "mcuboot";
			reg = <0x2400 0xdc00>;
		};

		slot0_partition: partition@10000 {
			label = "image-0";
			reg = <0x10000 DT_SIZE_K(1024)>;
		};

		storage_partition: partition@110000 {
			label = "storage";
			reg = <0x110000 DT_SIZE_K(4)>;
		};

		nvm_partition: partition@111000 {
			label = "nvm";
			reg = <0x111000 DT_SIZE_K(4)>;
		};

		filesystem_partition: partition@112000 {
			label = "filesystem";
			reg = <0x112000 DT_SIZE_K(3000)>;
		};
	};
};
