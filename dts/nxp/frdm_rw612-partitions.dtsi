/* Partition layout for frdm_rw612: the flash memory map shared by the
 * bootloader and every application image. Generated by
 * tools/partition_layout.py; do not edit by hand -- re-run
 * `python3 tools/partition_layout.py --fix frdm_rw612` after changing
 * the upstream board geometry or tools/boards.toml.
 *
 * Board-specific overlay glue (delete-nodes, device enablement,
 * aliases/chosen) lives in dts/nxp/frdm_rw612.dtsi, which includes
 * this file.
 */

&w25q512jvfiq {
	partitions {

		storage_partition: partition@620000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x620000 DT_SIZE_K(32)>;
		};

		nvm_partition: partition@628000 {
			compatible = "zephyr,mapped-partition";
			label = "nvm";
			reg = <0x628000 DT_SIZE_K(4)>;
		};

		fatfs_partition: partition@629000 {
			compatible = "zephyr,mapped-partition";
			label = "filesystem";
			reg = <0x629000 DT_SIZE_K(59228)>;
		};
	};
};
