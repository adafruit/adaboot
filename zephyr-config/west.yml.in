# West manifest for the standalone Adaboot build.
#
# This mirrors how CircuitPython's zephyr-cp port builds against Zephyr: a west
# workspace whose manifest imports the Adafruit fork of Zephyr. Run `make
# workspace` from the repo root to generate west.yml from this template and
# initialize the workspace.
#
# Generated west.yml is git-ignored (it is machine-specific only insofar as the
# Zephyr revision is pinned here); edit this template instead.
#
# Notes:
#   * Zephyr is imported with path-prefix "deps" so its projects (and the HALs)
#     land under deps/ and never collide with this repo's own zephyr/ (the Zephyr
#     module metadata) or tools/ directories.
#   * Zephyr's manifest would normally import the upstream mcuboot project at
#     bootloader/mcuboot. We block it: this repository *is* the mcuboot fork, and
#     is registered as the Zephyr module directly (the live working tree) via
#     EXTRA_ZEPHYR_MODULES in the Makefile. That avoids a second mcuboot checkout
#     and the duplicate MCUBOOT_BOOTUTIL target two mcuboot modules would
#     produce, and means `make build` compiles the tree you are editing.

manifest:
  projects:
    - name: zephyr
      url: https://github.com/adafruit/zephyr
      revision: @ZEPHYR_REV@
      clone-depth: 100
      path: zephyr
      import:
        path-prefix: deps
        name-blocklist:
          - mcuboot